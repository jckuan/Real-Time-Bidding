{
  "family": "rtb-app",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::YOUR_AWS_ACCOUNT_ID:role/RTB-ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::YOUR_AWS_ACCOUNT_ID:role/RTB-ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "rtb-app",
      "image": "YOUR_AWS_ACCOUNT_ID.dkr.ecr.us-west-2.amazonaws.com/rtb-app:latest",
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "3000"
        },
        {
          "name": "DB_HOST",
          "value": "YOUR_RDS_ENDPOINT"
        },
        {
          "name": "DB_PORT",
          "value": "5432"
        },
        {
          "name": "DB_NAME",
          "value": "rtb_database"
        },
        {
          "name": "REDIS_HOST",
          "value": "YOUR_REDIS_ENDPOINT"
        },
        {
          "name": "REDIS_PORT",
          "value": "6379"
        },
        {
          "name": "DEFAULT_ALPHA",
          "value": "1.0"
        },
        {
          "name": "DEFAULT_BETA",
          "value": "100.0"
        },
        {
          "name": "DEFAULT_GAMMA",
          "value": "50.0"
        },
        {
          "name": "RATE_LIMIT_WINDOW",
          "value": "60000"
        },
        {
          "name": "RATE_LIMIT_MAX_REQUESTS",
          "value": "100"
        },
        {
          "name": "CORS_ORIGIN",
          "value": "*"
        },
        {
          "name": "DB_POOL_MIN",
          "value": "5"
        },
        {
          "name": "DB_POOL_MAX",
          "value": "30"
        }
      ],
      "secrets": [
        {
          "name": "DB_USER",
          "valueFrom": "arn:aws:secretsmanager:us-west-2:YOUR_AWS_ACCOUNT_ID:secret:rtb/db/username-XXXXXX"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-west-2:YOUR_AWS_ACCOUNT_ID:secret:rtb/db/password-XXXXXX"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-west-2:YOUR_AWS_ACCOUNT_ID:secret:rtb/jwt/secret-XXXXXX"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/rtb-app",
          "awslogs-region": "us-west-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "node -e \"require('http').get('http://localhost:3000/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})\""],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 120
      }
    }
  ]
}
