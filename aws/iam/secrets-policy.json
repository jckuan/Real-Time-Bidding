{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:secretsmanager:*:*:secret:rtb/db/username*",
        "arn:aws:secretsmanager:*:*:secret:rtb/db/password*",
        "arn:aws:secretsmanager:*:*:secret:rtb/jwt/secret*"
      ]
    }
  ]
}
